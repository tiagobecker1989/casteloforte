    "lucide-react": "^0.562.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
