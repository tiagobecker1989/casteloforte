# ===== Obrigatórios em produção =====
# String aleatória longa: openssl rand -hex 32
JWT_SECRET=
# URL pública do sistema (usada nos links dos e-mails)
APP_URL=https://app.seudominio.org.br

# ===== Banco de dados =====
# Vazio = SQLite em DATA_DIR (só para desenvolvimento local). Para Postgres/Neon, informe a URL.
# Neon: use a connection string POOLED (host com -pooler) aqui:
DATABASE_URL=
# Neon: string DIRETA (sem -pooler), usada só para criar/atualizar tabelas no build (npm run db:migrate)
DATABASE_URL_UNPOOLED=
# Use PGSSL=1 se o provedor exigir SSL (Neon, Supabase, Render...)
PGSSL=
DATA_DIR=./data

# ===== Super admin da sede (criado só na 1ª execução; senha vazia => gerada e mostrada no console) =====
SEED_ADMIN_EMAIL=admin@castelofortesaas.local
SEED_ADMIN_PASSWORD=

# ===== E-mail (recuperação de senha e aprovação de cadastro). Sem SMTP_HOST, o e-mail só aparece no console =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Castelo Forte <nao-responder@seudominio.org.br>"

# ===== LGPD (aparecem nos textos legais) =====
DPO_EMAIL=encarregado@seudominio.org.br
OPERADORA_NOME=IELB Castelo Forte

# ===== Cobrança =====
TRIAL_DIAS=30
CARENCIA_DIAS=15
# Chave Pix exibida na tela "Assinatura" das paróquias
PIX_CHAVE=
# Segredo do webhook genérico (HMAC-SHA256 no cabeçalho x-signature). Opcional se usar só o Asaas
BILLING_WEBHOOK_SECRET=

# ===== Asaas (pagamento online: Pix, boleto e cartão) =====
# Chave de API: sandbox começa com $aact_hmlg_ e produção com $aact_prod_ (gere em Integrações > Chaves de API)
ASAAS_API_KEY=
# Token que VOCÊ define e cadastra no webhook do Asaas (mín. 32 caracteres; não use a chave de API). openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# ===== IA pastoral (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vercel Cron: segredo que a Vercel envia em Authorization: Bearer ... ao chamar /api/cron/cobranca
CRON_SECRET=

PORT=3000
